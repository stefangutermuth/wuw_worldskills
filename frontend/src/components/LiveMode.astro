---
import Tagebuch from './Tagebuch.astro';
import { posts as igPosts } from '../data/instagram.js';
const igCredits = [...new Set(igPosts.slice(0, 5).map((p) => p.credit).filter(Boolean))];
// Sektion „Die WM-Woche in Shanghai" (§A4, vormals „Live aus Shanghai"), seit 28.09.2026 Erinnerung.
// Vorfreude/Countdown, danach Tagebuch der WM-Woche (Reiter pro Tag, s. Tagebuch.astro).
// Während (Status=on / Dispatches vorhanden): Reportage (Featured + Karten).
// Public-Asset mit Base-Pfad (GitHub-Pages-Unterordner; lokal/Prod = '/').
const asset = (p) => import.meta.env.BASE_URL.replace(/\/$/, '') + (p.startsWith('/') ? p : '/' + p);
---

<section class="live" id="live" data-live="off" data-live-root aria-labelledby="live-title">
  <div class="live__bg" data-live-bg aria-hidden="true"></div>
  <div class="live__veil" aria-hidden="true"></div>
  <div class="live__grain atmo-grain atmo-grain--soft" aria-hidden="true"></div>

  <div class="live__inner u-container">
    <header class="live__head">
      <span class="live__badge">
        Die WM-Woche in Shanghai
      </span>
    </header>

    <!-- AKTUELL: jeweils die neueste Meldung. Zum Austauschen einfach Badge, Text und Meta ersetzen. -->
    <aside class="live__update">
      <span class="live__update-badge">Aktuell · 27. September</span>
      <p class="live__update-text">
        <strong>Bronze für Marc-Aurel &amp; Lennard!</strong> Bei der Siegerehrung in Shanghai haben die beiden die <strong>Bronzemedaille</strong> im Skill 37 „Landscape Gardening" geholt. Vier Tage Arbeit, ein fertiger Garten und am Ende ein Platz auf dem Podest. Wir sind mächtig stolz. 🥉
      </p>
      <a class="live__update-live" href="https://www.youtube.com/live/2yamAa_pcOU" target="_blank" rel="noopener">
        <i class="fa-brands fa-youtube" aria-hidden="true"></i> Siegerehrung ansehen
      </a>
      <p class="live__update-meta">
        Bilder von der Medaillenübergabe im <a href="#tag-2709">Tagebuch</a> · Fotos: AuGaLa/Reidel
      </p>
    </aside>

    <!-- Der Bronze-Beitrag von WorldSkills Germany, sichtbar auf der Seite.
         Zwei-Klick: der Instagram-Rahmen wird erst nach dem Klick geladen, vorher geht nichts an Meta. -->
    <div class="live__post" data-live-post>
      <p class="live__post-label"><i class="fa-brands fa-instagram" aria-hidden="true"></i> WorldSkills Germany meldet Bronze</p>
      <div class="live__post-frame" data-live-post-frame data-embed="https://www.instagram.com/p/Ddyg3Y9gEsj/embed">
        <button type="button" class="live__post-btn" data-live-post-load>Beitrag anzeigen</button>
        <p class="live__post-note">Der Beitrag wird von Instagram geladen, dabei entsteht eine Verbindung zu Instagram (Meta).</p>
      </div>
      <p class="live__post-meta">
        <a href="https://www.instagram.com/p/Ddyg3Y9gEsj/" target="_blank" rel="noopener">Beitrag direkt auf Instagram öffnen</a>
      </p>
    </div>

    <!-- Vorfreude (vor dem Event): Zahl · Label · Datum in einer zentrierten Zeile -->
    <div class="live__pre" data-live-pre>
      <h2 id="live-title" class="live__cd">
        <span class="live__cd-num" data-live-days>–</span>
        <span class="live__cd-unit">Tage bis Shanghai</span>
        <span class="live__cd-sep" aria-hidden="true">·</span>
        <span class="live__cd-date">22.–27. September 2026</span>
      </h2>
      <p class="live__cd-text">
        bis zum ersten Bericht direkt aus dem National Exhibition and Convention Center.
      </p>
    </div>

    <!-- Tagebuch der WM-Woche: Reiter pro Tag, Inhalte in src/data/tagebuch.js -->
    <Tagebuch />

    <!-- Zum Nachschauen (seit 28.09.2026 statt Programm und „So bist du dabei“):
         Aufzeichnungen und die Kanäle, auf denen die WM-Woche gezeigt wurde. Bewusst kompakt. -->
    <div class="live__replay">
      <h3 class="live__sub">Zum Nachschauen</h3>
      <div class="live__replay-rows">
        <div class="live__replay-row">
          <span class="live__follow-label">Aufzeichnungen</span>
          <div class="live__follow-links">
            <a class="live__follow-live" href="https://www.youtube.com/live/2yamAa_pcOU" target="_blank" rel="noopener"><i class="fa-brands fa-youtube" aria-hidden="true"></i> Siegerehrung</a>
            <a class="live__follow-live" href="https://www.youtube.com/watch?v=8CnEnzlDPfw" target="_blank" rel="noopener"><i class="fa-brands fa-youtube" aria-hidden="true"></i> Eröffnungsfeier</a>
          </div>
        </div>
        <div class="live__replay-row">
          <span class="live__follow-label">Beiträge</span>
          <div class="live__follow-links">
            <a href="https://www.instagram.com/die_landschaftsgaertner/" target="_blank" rel="noopener"><i class="fa-brands fa-instagram" aria-hidden="true"></i> Die Landschaftsgärtner</a>
            <a href="https://www.instagram.com/worldskills_germany/" target="_blank" rel="noopener"><i class="fa-brands fa-instagram" aria-hidden="true"></i> Team Germany</a>
            <a href="https://www.youtube.com/@Ausbildung_galabau" target="_blank" rel="noopener"><i class="fa-brands fa-youtube" aria-hidden="true"></i> Ausbildung GaLaBau</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Reportage (erscheint, sobald Berichte da sind) -->
    <div class="live__featured" data-live-featured hidden></div>
    <div class="live__cards" data-live-cards></div>

    <!-- Instagram-Feed-Vorschau (Stockbilder; später echter Feed übers Plugin) -->
    <div class="live__insta">
      <div class="live__insta-head">
        <p class="live__insta-label">#RoadToShanghai auf Instagram</p>
        <div class="live__insta-follow">
          <a class="live__insta-btn" href="https://www.instagram.com/wirth_wiener_gmbh/" target="_blank" rel="noopener" aria-label="Wirth &amp; Wiener auf Instagram">
            <i class="fa-brands fa-instagram" aria-hidden="true"></i><span>@wirth_wiener_gmbh</span>
          </a>
          <a class="live__insta-btn live__insta-btn--ghost" href="https://www.instagram.com/galabau_sachsen/" target="_blank" rel="noopener" aria-label="GaLaBau Sachsen auf Instagram">
            <i class="fa-brands fa-instagram" aria-hidden="true"></i><span>@galabau_sachsen</span>
          </a>
        </div>
      </div>
      <div class="live__insta-grid" data-insta-grid data-insta-fixed={igPosts.length ? '' : undefined}>
        {igPosts.length > 0
          ? igPosts.slice(0, 5).map((p) => (
              <a class="live__insta-tile" href={p.url} target="_blank" rel="noopener">
                <picture>
                  <source srcset={asset(`${p.image}.webp`)} type="image/webp" />
                  <img src={asset(`${p.image}.jpg`)} alt={p.alt} loading="lazy" width="560" height="373" />
                </picture>
              </a>
            ))
          : [1, 2, 3, 4, 5].map((n) => (
              <figure class="live__insta-tile">
                <picture>
                  <source srcset={asset(`/img/live/insta/insta-${n}.avif`)} type="image/avif" />
                  <source srcset={asset(`/img/live/insta/insta-${n}.webp`)} type="image/webp" />
                  <img src={asset(`/img/live/insta/insta-${n}.jpg`)} alt="" loading="lazy" width="600" height="600" />
                </picture>
              </figure>
            ))}
      </div>
      {igCredits.length > 0 && <p class="live__insta-credit">Fotos: {igCredits.join(' · ')}</p>}
      <p class="live__hashtags">#WorldSkillsShanghai · #maximalzusammen · #teamgermany2026</p>
    </div>
  </div>
</section>

<script>
  import { initLive } from '../scripts/live.js';
  initLive(document.querySelector('[data-live-root]'));
</script>

<style>
  .live {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip; /* nicht intern scrollbar (Suche/Fokus) */
    color: var(--paper);
    padding-block: clamp(4.5rem, 12vh, 8rem);
    background: var(--night); /* Fallback */
  }
  /* Shanghai-Nacht als zoombare Bild-Ebene */
  .live__bg {
    position: absolute;
    inset: -6%;
    z-index: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-image: url('/img/live/live-bg.jpg');
    background-image: image-set(
      '/img/live/live-bg.avif' type('image/avif'),
      '/img/live/live-bg.webp' type('image/webp'),
      '/img/live/live-bg.jpg' type('image/jpeg')
    );
    /* Skyline ist sehr hell/bunt → für Lesbarkeit deutlich abdunkeln */
    filter: brightness(0.5) saturate(0.9);
    will-change: transform;
  }
  .live__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(100% 60% at 50% 0%, rgba(168, 30, 46, 0.16), transparent 55%),
      linear-gradient(180deg, rgba(8, 14, 22, 0.82) 0%, rgba(8, 14, 22, 0.66) 45%, rgba(8, 12, 16, 0.92) 100%);
  }
  .live__grain { z-index: 2; }
  .live__inner { position: relative; z-index: 3; }

  .live__head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .live__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 75, 0.45);
    background: rgba(201, 162, 75, 0.1);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* ---------- Vorfreude-Block (zentriert) ---------- */
  .live__pre {
    margin-top: clamp(1.4rem, 3.5vh, 2.2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.7rem;
  }
  /* Zahl · Label · Datum in EINER zentrierten Zeile (umbricht auf Schmal sauber) */
  .live__cd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem 0.7rem;
    margin: 0;
    line-height: 1.1;
  }
  .live__cd-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 0.9;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
    text-shadow: 0 4px 30px var(--gold-glow);
  }
  .live__cd-unit {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.1rem, 2.4vw, 1.7rem);
    color: var(--paper);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
  }
  @media (max-width: 560px) { .live__cd-sep { display: none; } } /* sonst hängt der Punkt am Zeilenende */
  .live__cd-sep {
    color: rgba(201, 162, 75, 0.6);
    font-size: clamp(1rem, 2vw, 1.4rem);
  }
  .live__cd-date {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    color: var(--gold);
    letter-spacing: 0.005em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }
  .live__cd-text {
    max-width: 50ch;
    margin: 0 auto;
    color: rgba(241, 232, 214, 0.92);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
  }

  /* ---------- Reportage ---------- */
  .live__featured {
    margin-top: 2.5rem;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid rgba(201, 162, 75, 0.25);
    background: rgba(255, 255, 255, 0.03);
  }
  :global(.live__featured-img) { width: 100%; height: auto; display: block; }
  :global(.live__featured-body) { padding: clamp(1.25rem, 3vw, 2rem); }
  :global(.live__featured-title) { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0.4rem 0 0.6rem; color: var(--gold); }

  .live__cards {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .live__cards { grid-template-columns: 1fr 1fr; } }
  :global(.live__card) {
    border: 1px solid rgba(201, 162, 75, 0.2);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }
  :global(.live__card-img) { width: 100%; height: auto; display: block; }
  :global(.live__card h4) { font-family: var(--font-display); font-size: 1.3rem; margin: 0.3rem 0; padding-inline: 1rem; }
  :global(.live__card p) { padding: 0 1rem 1rem; color: var(--ink-soft); }
  :global(.live__date) {
    display: inline-block;
    padding: 0.75rem 1rem 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* ---------- Instagram ---------- */
  .live__insta { margin-top: clamp(1.8rem, 4vh, 3rem); }
  .live__insta-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
    margin-bottom: 1rem;
  }
  .live__insta-label {
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0;
  }
  .live__insta-follow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .live__insta-btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 75, 0.4);
    background: rgba(201, 162, 75, 0.1);
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.22s ease, transform 0.18s var(--ease-out);
  }
  .live__insta-btn i { font-size: 0.95rem; }
  .live__insta-btn:hover { background: rgba(201, 162, 75, 0.2); transform: translateY(-2px); }
  .live__insta-btn--ghost {
    background: transparent;
    border-color: rgba(241, 232, 214, 0.2);
    color: var(--ink-soft);
  }
  .live__insta-btn--ghost:hover { background: rgba(241, 232, 214, 0.06); }
  .live__insta-grid {
    display: grid;
    /* Spalten richten sich nach der Anzahl der Kacheln (Feed: 5, feste Liste: auch weniger) */
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .live__insta-grid::-webkit-scrollbar { display: none; }
  .live__insta-grid > :global(*) { scroll-snap-align: start; }
  @media (max-width: 600px) {
    /* zweieinhalb Kacheln sichtbar → man sieht sofort, dass es weitergeht */
    .live__insta-grid { grid-auto-columns: 40vw; }
  }

  /* global, damit auch die per JS eingefügten echten Instagram-Kacheln greifen */
  :global(.live__insta-tile) {
    position: relative;
    display: block;
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid rgba(201, 162, 75, 0.18);
  }
  /* <picture> ist inline, ohne eigene Hoehe greift height:100% am Bild nicht */
  :global(.live__insta-tile picture) { display: block; width: 100%; height: 100%; }
  :global(.live__insta-tile img) {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.95) brightness(0.96);
    transition: transform 0.55s var(--ease-out), filter 0.4s ease;
  }
  :global(.live__insta-tile::after) {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(12, 22, 34, 0.5));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  :global(.live__insta-tile:hover img) { transform: scale(1.08); filter: saturate(1.12) brightness(1.05); }
  :global(.live__insta-tile:hover::after) { opacity: 1; }

  .live__insta-credit {
    margin: 0.7rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .live__hashtags {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--gold);
  }

  /* ---------- Eingebetteter Instagram-Beitrag (Zwei-Klick) ---------- */
  .live__post {
    margin-top: clamp(1.2rem, 3vh, 1.8rem);
    padding: 1.1rem 1.2rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid rgba(201, 162, 75, 0.28);
    background: rgba(9, 15, 24, 0.75);
    backdrop-filter: blur(8px);
  }
  .live__post-label {
    margin: 0 0 0.8rem;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .live__post-label i { margin-right: 0.45rem; }
  .live__post-frame {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 220px;
    padding: 1.4rem 1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    text-align: center;
  }
  .live__post-frame.is-loaded { display: block; padding: 0; min-height: 0; background: none; }
  .live__post-btn {
    min-height: 44px;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 75, 0.5);
    background: rgba(201, 162, 75, 0.12);
    color: var(--gold);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .live__post-btn:hover { background: rgba(201, 162, 75, 0.2); border-color: var(--gold); }
  .live__post-note { margin: 0; max-width: 32rem; font-size: 0.78rem; line-height: 1.5; color: var(--ink-soft); }
  .live__post-meta { margin: 0.7rem 0 0; font-size: 0.8rem; color: var(--ink-soft); }
  .live__post-meta a { color: var(--gold); }
  :global(.live__post-iframe) {
    display: block;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    border: 0;
    border-radius: 12px;
    background: #fff;
    min-height: 680px;
  }

  /* ---------- Aktuell-Karte (temporär) ---------- */
  .live__update {
    margin-top: clamp(1.5rem, 4vh, 2.2rem);
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    border: 1px solid rgba(201, 162, 75, 0.3);
    border-left: 3px solid var(--china-red);
    background: rgba(9, 15, 24, 0.82);
    backdrop-filter: blur(8px);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.35);
  }
  .live__update-badge {
    display: inline-block;
    margin-bottom: 0.55rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(168, 30, 46, 0.18);
    border: 1px solid rgba(168, 30, 46, 0.5);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ff9a8a;
  }
  .live__update-text {
    color: rgba(241, 232, 214, 0.9);
    line-height: 1.6;
    font-size: 0.96rem;
  }
  .live__update-text strong { color: var(--gold); }
  .live__update-meta {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .live__update-meta a { color: var(--gold); text-decoration: underline; }

  /* ---------- Zum Nachschauen (kompakt, seit 28.09.2026) ---------- */
  .live__replay {
    margin-top: clamp(2rem, 5vh, 3rem);
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    border: 1px solid rgba(201, 162, 75, 0.28);
    background: rgba(9, 15, 24, 0.78);
    backdrop-filter: blur(8px);
  }
  .live__replay .live__sub { text-align: left; font-size: 1.15rem; margin-bottom: 0.9rem; }
  .live__replay-rows { display: grid; gap: 0.9rem 2rem; }
  @media (min-width: 900px) { .live__replay-rows { grid-template-columns: auto 1fr; } }
  .live__follow-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .live__follow-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .live__follow-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 75, 0.35);
    color: var(--paper);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.18s var(--ease-out);
  }
  .live__follow-links a:hover {
    border-color: var(--gold);
    color: var(--gold);
    transform: translateY(-2px);
  }
  .live__follow-links i { font-size: 0.95rem; }
  /* Livestream-Links (Eröffnungsfeier): rot hervorgehoben, sonst wie die übrigen */
  .live__follow-links a.live__follow-live {
    border-color: rgba(168, 30, 46, 0.7);
    background: rgba(168, 30, 46, 0.22);
  }
  .live__follow-links a.live__follow-live:hover { border-color: #ff6b6b; color: #fff; }
  .live__follow-live i, .live__update-live i { color: #ff4d4d; }
  .live__update-live {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 0.8rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(168, 30, 46, 0.7);
    background: rgba(168, 30, 46, 0.22);
