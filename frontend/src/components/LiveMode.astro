---
import Tagebuch from './Tagebuch.astro';
// Sektion „Live aus Shanghai" (§A4) – Reportage-Dashboard.
// Vorfreude/Countdown, danach Tagebuch der WM-Woche (Reiter pro Tag, s. Tagebuch.astro).
// Während (Status=on / Dispatches vorhanden): Reportage (Featured + Karten).
// Programm-Woche in Shanghai (Quelle: WorldSkills-Germany-Presseinfo).
const programm = [
  { date: '17. Sep', label: 'Anreise nach Shanghai' },
  // Offizieller Livestream von WorldSkills (YouTube, Start 22.09. 12:00 UTC = 14 Uhr MESZ)
  { date: '22. Sep', label: 'Eröffnungsfeier', live: { url: 'https://www.youtube.com/watch?v=8CnEnzlDPfw', text: 'Aufzeichnung auf YouTube' } },
  { date: '23.–26. Sep', label: '4 Tage Wettkampf' },
  { date: '27. Sep', label: 'Siegerehrung & Abschluss' },
];
// Public-Asset mit Base-Pfad (GitHub-Pages-Unterordner; lokal/Prod = '/').
const asset = (p) => import.meta.env.BASE_URL.replace(/\/$/, '') + (p.startsWith('/') ? p : '/' + p);
---

<section class="live" id="live" data-live="off" data-live-root aria-labelledby="live-title">
  <div class="live__bg" data-live-bg aria-hidden="true"></div>
  <div class="live__veil" aria-hidden="true"></div>
  <div class="live__grain atmo-grain atmo-grain--soft" aria-hidden="true"></div>

  <div class="live__inner u-container">
    <header class="live__head">
      <span class="live__badge">
        <span class="live__dot" aria-hidden="true"></span> Live aus Shanghai
      </span>
    </header>

    <!-- AKTUELL: jeweils die neueste Meldung. Zum Austauschen einfach Badge, Text und Meta ersetzen. -->
    <aside class="live__update">
      <span class="live__update-badge">Aktuell · 25. September</span>
      <p class="live__update-text">
        <strong>Tag 2 ist geschafft, und er hatte es in sich.</strong> Deutlich härter als der erste Tag, das Zeitlimit haben Marc-Aurel &amp; Lennard gerade so gehalten. Mit ihrem Zwischenstand sind sie zufrieden. Gerade läuft <strong>Tag 3</strong> auf Fläche 13, am Samstag ist der letzte Wettkampftag. 🇨🇳
      </p>
      <a class="live__update-live" href="https://www.youtube.com/watch?v=8CnEnzlDPfw" target="_blank" rel="noopener">
        <i class="fa-brands fa-youtube" aria-hidden="true"></i> Eröffnungsfeier nachschauen
      </a>
      <p class="live__update-meta">
        Neue Bilder im <a href="#tag-2409">Tagebuch</a> · Fotos: AuGaLa/Reidel
      </p>
    </aside>

    <!-- Vorfreude (vor dem Event): Zahl · Label · Datum in einer zentrierten Zeile -->
    <div class="live__pre" data-live-pre>
      <h2 id="live-title" class="live__cd">
        <span class="live__cd-num" data-live-days>–</span>
        <span class="live__cd-unit">Tage bis Shanghai</span>
        <span class="live__cd-sep" aria-hidden="true">·</span>
        <span class="live__cd-date">22.–27. September 2026</span>
      </h2>
      <p class="live__cd-text">
        bis zum ersten Bericht direkt aus dem National Exhibition and Convention Center.
      </p>
    </div>

    <!-- Tagebuch der WM-Woche: Reiter pro Tag, Inhalte in src/data/tagebuch.js -->
    <Tagebuch />

    <!-- Programm-Woche in Shanghai -->
    <div class="live__programm">
      <h3 class="live__sub">Das Programm in Shanghai</h3>
      <ol class="live__timeline">
        {programm.map((p) => (
          <li class="live__tl-item">
            <span class="live__tl-date">{p.date}</span>
            <span class="live__tl-label">{p.label}</span>
            {p.live && (
              <a class="live__tl-live" href={p.live.url} target="_blank" rel="noopener">
                <i class="fa-brands fa-youtube" aria-hidden="true"></i> {p.live.text}
              </a>
            )}
          </li>
        ))}
      </ol>
      <div class="live__notes">
        <p class="live__note">
          <i class="fa-solid fa-ticket-simple" aria-hidden="true"></i>
          <span>Du reist mit nach Shanghai? <a href="https://worldskills2026.com/" target="_blank" rel="noopener">Tickets für Eröffnung &amp; Siegerehrung</a> gibt es über die offizielle Event-Seite.</span>
        </p>
        <p class="live__note">
          <span class="mascot-dots" aria-hidden="true"><span class="mascot-dot mascot-dot--blue"></span><span class="mascot-dot mascot-dot--red"></span></span>
          <span>Die Maskottchen 2026: <strong>Neng Neng</strong> &amp; <strong>Qiao Qiao</strong>. Motto: „Master Skills, Change Your Future“.</span>
        </p>
      </div>
    </div>

    <!-- So bist du dabei. Stand 21.09.2026: Die ERÖFFNUNGSFEIER streamt WorldSkills live auf
         YouTube (22.09., 14 Uhr MESZ). Von den WETTKÄMPFEN gibt es keinen Livestream (Info
         WorldSkills Germany, 11.09.) – dafür die Kanäle, die täglich berichten. -->
    <div class="live__watch">
      <div class="live__watch-text">
        <h3 class="live__sub"><i class="fa-solid fa-share-nodes" aria-hidden="true"></i> So bist du dabei</h3>
        <p>
          Die Eröffnungsfeier gibt es als Aufzeichnung auf YouTube. Von den Wettkämpfen selbst gibt es
          keinen Livestream, damit die Teams ungestört arbeiten können. Die Bilder kommen trotzdem: Team
          Germany berichtet täglich auf Social Media, die Landschaftsgärtner zeigen den Baufortschritt, und
          hier auf der Seite erscheinen die Berichte von Marc-Aurel &amp; Lennard.
        </p>
      </div>
      <div class="live__follow">
        <div class="live__follow-group">
          <span class="live__follow-label">Eröffnungsfeier <span class="live__follow-sub">· Aufzeichnung</span></span>
          <div class="live__follow-links">
            <a class="live__follow-live" href="https://www.youtube.com/watch?v=8CnEnzlDPfw" target="_blank" rel="noopener" aria-label="Aufzeichnung der Eröffnungsfeier auf YouTube"><i class="fa-brands fa-youtube" aria-hidden="true"></i> Auf YouTube ansehen</a>
          </div>
        </div>
        <div class="live__follow-group">
          <span class="live__follow-label">Team Germany</span>
          <div class="live__follow-links">
            <a href="https://www.instagram.com/worldskills_germany/" target="_blank" rel="noopener" aria-label="WorldSkills Germany auf Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i> Instagram</a>
            <a href="https://www.facebook.com/WorldSkillsGermany/" target="_blank" rel="noopener" aria-label="WorldSkills Germany auf Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i> Facebook</a>
            <a href="https://www.linkedin.com/company/worldskills-germany" target="_blank" rel="noopener" aria-label="WorldSkills Germany auf LinkedIn"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i> LinkedIn</a>
          </div>
        </div>
        <div class="live__follow-group">
          <span class="live__follow-label">Die Landschaftsgärtner <span class="live__follow-sub">· Baufortschritt</span></span>
          <div class="live__follow-links">
            <a href="https://www.instagram.com/die_landschaftsgaertner/" target="_blank" rel="noopener" aria-label="Die Landschaftsgärtner auf Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i> Instagram</a>
            <a href="https://www.facebook.com/dielandschaftsgaertner" target="_blank" rel="noopener" aria-label="Die Landschaftsgärtner auf Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i> Facebook</a>
            <a href="https://www.tiktok.com/@ausbildung_galabau" target="_blank" rel="noopener" aria-label="Ausbildung GaLaBau auf TikTok"><i class="fa-brands fa-tiktok" aria-hidden="true"></i> TikTok</a>
            <a href="https://www.youtube.com/@Ausbildung_galabau" target="_blank" rel="noopener" aria-label="Ausbildung GaLaBau auf YouTube"><i class="fa-brands fa-youtube" aria-hidden="true"></i> YouTube</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Reportage (erscheint, sobald Berichte da sind) -->
    <div class="live__featured" data-live-featured hidden></div>
    <div class="live__cards" data-live-cards></div>

    <!-- Instagram-Feed-Vorschau (Stockbilder; später echter Feed übers Plugin) -->
    <div class="live__insta">
      <div class="live__insta-head">
        <p class="live__insta-label">#RoadToShanghai auf Instagram</p>
        <div class="live__insta-follow">
          <a class="live__insta-btn" href="https://www.instagram.com/wirth_wiener_gmbh/" target="_blank" rel="noopener" aria-label="Wirth &amp; Wiener auf Instagram">
            <i class="fa-brands fa-instagram" aria-hidden="true"></i><span>@wirth_wiener_gmbh</span>
          </a>
          <a class="live__insta-btn live__insta-btn--ghost" href="https://www.instagram.com/galabau_sachsen/" target="_blank" rel="noopener" aria-label="GaLaBau Sachsen auf Instagram">
            <i class="fa-brands fa-instagram" aria-hidden="true"></i><span>@galabau_sachsen</span>
          </a>
        </div>
      </div>
      <div class="live__insta-grid" data-insta-grid>
        {[1, 2, 3, 4, 5].map((n) => (
          <figure class="live__insta-tile">
            <picture>
              <source srcset={asset(`/img/live/insta/insta-${n}.avif`)} type="image/avif" />
              <source srcset={asset(`/img/live/insta/insta-${n}.webp`)} type="image/webp" />
              <img src={asset(`/img/live/insta/insta-${n}.jpg`)} alt="" loading="lazy" width="600" height="600" />
            </picture>
          </figure>
        ))}
      </div>
      <p class="live__hashtags">#WorldSkillsShanghai · #maximalzusammen · #teamgermany2026</p>
    </div>
  </div>
</section>

<script>
  import { initLive } from '../scripts/live.js';
  initLive(document.querySelector('[data-live-root]'));
</script>

<style>
  .live {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip; /* nicht intern scrollbar (Suche/Fokus) */
    color: var(--paper);
    padding-block: clamp(4.5rem, 12vh, 8rem);
    background: var(--night); /* Fallback */
  }
  /* Shanghai-Nacht als zoombare Bild-Ebene */
  .live__bg {
    position: absolute;
    inset: -6%;
    z-index: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-image: url('/img/live/live-bg.jpg');
    background-image: image-set(
      '/img/live/live-bg.avif' type('image/avif'),
      '/img/live/live-bg.webp' type('image/webp'),
      '/img/live/live-bg.jpg' type('image/jpeg')
    );
    /* Skyline ist sehr hell/bunt → für Lesbarkeit deutlich abdunkeln */
    filter: brightness(0.5) saturate(0.9);
    will-change: transform;
  }
  .live__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(100% 60% at 50% 0%, rgba(168, 30, 46, 0.16), transparent 55%),
      linear-gradient(180deg, rgba(8, 14, 22, 0.82) 0%, rgba(8, 14, 22, 0.66) 45%, rgba(8, 12, 16, 0.92) 100%);
  }
  .live__grain { z-index: 2; }
  .live__inner { position: relative; z-index: 3; }

  .live__head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .live__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(168, 30, 46, 0.5);
    background: rgba(168, 30, 46, 0.16);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff9a8a;
  }
  .live__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--china-red);
    animation: live-pulse 1.8s ease-out infinite;
  }
  @keyframes live-pulse {
    0% { box-shadow: 0 0 0 0 rgba(168, 30, 46, 0.6); }
    70% { box-shadow: 0 0 0 9px rgba(168, 30, 46, 0); }
    100% { box-shadow: 0 0 0 0 rgba(168, 30, 46, 0); }
  }

  /* ---------- Vorfreude-Block (zentriert) ---------- */
  .live__pre {
    margin-top: clamp(1.4rem, 3.5vh, 2.2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.7rem;
  }
  /* Zahl · Label · Datum in EINER zentrierten Zeile (umbricht auf Schmal sauber) */
  .live__cd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem 0.7rem;
    margin: 0;
    line-height: 1.1;
  }
  .live__cd-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 0.9;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
    text-shadow: 0 4px 30px var(--gold-glow);
  }
  .live__cd-unit {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.1rem, 2.4vw, 1.7rem);
    color: var(--paper);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
  }
  @media (max-width: 560px) { .live__cd-sep { display: none; } } /* sonst hängt der Punkt am Zeilenende */
  .live__cd-sep {
    color: rgba(201, 162, 75, 0.6);
    font-size: clamp(1rem, 2vw, 1.4rem);
  }
  .live__cd-date {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    color: var(--gold);
    letter-spacing: 0.005em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }
  .live__cd-text {
    max-width: 50ch;
    margin: 0 auto;
    color: rgba(241, 232, 214, 0.92);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
  }

  /* ---------- Reportage ---------- */
  .live__featured {
    margin-top: 2.5rem;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid rgba(201, 162, 75, 0.25);
    background: rgba(255, 255, 255, 0.03);
  }
  :global(.live__featured-img) { width: 100%; height: auto; display: block; }
  :global(.live__featured-body) { padding: clamp(1.25rem, 3vw, 2rem); }
  :global(.live__featured-title) { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0.4rem 0 0.6rem; color: var(--gold); }

  .live__cards {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .live__cards { grid-template-columns: 1fr 1fr; } }
  :global(.live__card) {
    border: 1px solid rgba(201, 162, 75, 0.2);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }
  :global(.live__card-img) { width: 100%; height: auto; display: block; }
  :global(.live__card h4) { font-family: var(--font-display); font-size: 1.3rem; margin: 0.3rem 0; padding-inline: 1rem; }
  :global(.live__card p) { padding: 0 1rem 1rem; color: var(--ink-soft); }
  :global(.live__date) {
    display: inline-block;
    padding: 0.75rem 1rem 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* ---------- Instagram ---------- */
  .live__insta { margin-top: clamp(1.8rem, 4vh, 3rem); }
  .live__insta-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
    margin-bottom: 1rem;
  }
  .live__insta-label {
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0;
  }
  .live__insta-follow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .live__insta-btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 75, 0.4);
    background: rgba(201, 162, 75, 0.1);
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.22s ease, transform 0.18s var(--ease-out);
  }
  .live__insta-btn i { font-size: 0.95rem; }
  .live__insta-btn:hover { background: rgba(201, 162, 75, 0.2); transform: translateY(-2px); }
  .live__insta-btn--ghost {
    background: transparent;
    border-color: rgba(241, 232, 214, 0.2);
    color: var(--ink-soft);
  }
  .live__insta-btn--ghost:hover { background: rgba(241, 232, 214, 0.06); }
  .live__insta-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .live__insta-grid::-webkit-scrollbar { display: none; }
  .live__insta-grid > :global(*) { scroll-snap-align: start; }
  @media (max-width: 600px) {
    /* zweieinhalb Kacheln sichtbar → man sieht sofort, dass es weitergeht */
    .live__insta-grid { grid-template-columns: repeat(5, 40vw); }
  }

  /* global, damit auch die per JS eingefügten echten Instagram-Kacheln greifen */
  :global(.live__insta-tile) {
    position: relative;
    display: block;
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid rgba(201, 162, 75, 0.18);
  }
  :global(.live__insta-tile img) {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.95) brightness(0.96);
    transition: transform 0.55s var(--ease-out), filter 0.4s ease;
  }
  :global(.live__insta-tile::after) {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(12, 22, 34, 0.5));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  :global(.live__insta-tile:hover img) { transform: scale(1.08); filter: saturate(1.12) brightness(1.05); }
  :global(.live__insta-tile:hover::after) { opacity: 1; }

  .live__hashtags {
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--gold);
  }

  /* ---------- Aktuell-Karte (temporär) ---------- */
  .live__update {
    margin-top: clamp(1.5rem, 4vh, 2.2rem);
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    border: 1px solid rgba(201, 162, 75, 0.3);
    border-left: 3px solid var(--china-red);
    background: rgba(9, 15, 24, 0.82);
    backdrop-filter: blur(8px);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.35);
  }
  .live__update-badge {
    display: inline-block;
    margin-bottom: 0.55rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(168, 30, 46, 0.18);
    border: 1px solid rgba(168, 30, 46, 0.5);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ff9a8a;
  }
  .live__update-text {
    color: rgba(241, 232, 214, 0.9);
    line-height: 1.6;
    font-size: 0.96rem;
  }
  .live__update-text strong { color: var(--gold); }
  .live__update-meta {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .live__update-meta a { color: var(--gold); text-decoration: underline; }

  /* ---------- So bist du dabei (kein Livestream, Social-Kanäle) ---------- */
  .live__watch {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem 2rem;
    padding: 1.4rem 1.6rem;
    border-radius: var(--radius);
    border: 1px solid rgba(201, 162, 75, 0.3);
    background: rgba(9, 15, 24, 0.82);
    backdrop-filter: blur(8px);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.35);
  }
  .live__watch-text { flex: 1 1 320px; }
  .live__watch-text .live__sub {
    text-align: left;
    font-size: 1.15rem;
    margin-bottom: 0.45rem;
  }
  .live__watch-text .live__sub i { color: var(--gold); }
  .live__watch-text p {
    color: rgba(241, 232, 214, 0.9);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .live__follow {
    flex: 1 1 300px;
    display: grid;
    gap: 0.9rem;
  }
  .live__follow-sub { white-space: nowrap; }
  .live__follow-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .live__follow-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .live__follow-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 75, 0.35);
    color: var(--paper);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.18s var(--ease-out);
  }
  .live__follow-links a:hover {
    border-color: var(--gold);
    color: var(--gold);
    transform: translateY(-2px);
  }
  .live__follow-links i { font-size: 0.95rem; }
  /* Livestream-Links (Eröffnungsfeier): rot hervorgehoben, sonst wie die übrigen */
  .live__follow-links a.live__follow-live {
    border-color: rgba(168, 30, 46, 0.7);
    background: rgba(168, 30, 46, 0.22);
  }
  .live__follow-links a.live__follow-live:hover { border-color: #ff6b6b; color: #fff; }
  .live__follow-live i, .live__update-live i, .live__tl-live i { color: #ff4d4d; }
  .live__update-live {
