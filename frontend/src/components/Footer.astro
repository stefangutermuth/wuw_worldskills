---
// Footer (§A0): Newsletter, Sponsoren, Teilen, Rechtliches.
import Newsletter from './Newsletter.astro';
// Public-Asset mit Base-Pfad (GitHub-Pages-Unterordner; lokal/Prod = '/').
const asset = (p) => import.meta.env.BASE_URL.replace(/\/$/, '') + (p.startsWith('/') ? p : '/' + p);

// Bestell-Mail für die Landschaftsgärtner-Limonade (Bestellungen gehen direkt an W&W)
const limoBody = `Hallo Team Wirth & Wiener,

ich möchte folgende Kästen der Landschaftsgärtner-Limonade „Gurke-Zitrone" bestellen:

Anzahl Kästen:
Name:
Lieferadresse:
Telefon:

Vielen Dank!`;
const limoHref = `mailto:info@wirth-wiener.de?subject=${encodeURIComponent('Bestellung Landschaftsgärtner-Limonade')}&body=${encodeURIComponent(limoBody)}`;
---

<footer class="footer" id="newsletter">
  <div class="footer__inner u-container">
    <div class="footer__top">
      <!-- Newsletter (Anmeldung für Updates) -->
      <Newsletter compact />

      <!-- Teilen -->
      <div class="footer__share">
        <h3 class="footer__h">Teile das Abenteuer</h3>
        <p class="footer__lead">Hilf mit, dass möglichst viele die Daumen drücken.</p>
        <div class="footer__social" data-share>
          <a class="social-icon" data-share-wa target="_blank" rel="noopener" href="#" aria-label="Per WhatsApp teilen">
            <i class="fa-brands fa-whatsapp"></i>
          </a>
          <a class="social-icon" data-share-fb target="_blank" rel="noopener" href="#" aria-label="Auf Facebook teilen">
            <i class="fa-brands fa-facebook-f"></i>
          </a>
          <a class="social-icon" data-share-x target="_blank" rel="noopener" href="#" aria-label="Auf X teilen">
            <i class="fa-brands fa-x-twitter"></i>
          </a>
          <a class="social-icon" data-share-insta target="_blank" rel="noopener" href="https://www.instagram.com/" aria-label="Instagram">
            <i class="fa-brands fa-instagram"></i>
          </a>
          <button type="button" class="social-icon" data-share-copy aria-label="Link kopieren">
            <i class="fa-solid fa-link"></i>
          </button>
        </div>
        <p class="footer__share-status" data-share-status aria-live="polite"></p>
        <p class="footer__hashtags">#WorldSkillsShanghai · #maximalzusammen · #teamgermany2026</p>
      </div>
    </div>

    <!-- Unterstützen: Limo kaufen + Spenden -->
    <div class="footer__support" id="unterstuetzen" style="scroll-margin-top: 90px;">

      <!-- Landschaftsgärtner-Limonade -->
      <div class="footer__limo">
        <a class="footer__limo-media" href={limoHref} aria-label="Landschaftsgärtner-Limonade bestellen">
          <picture>
            <source media="(min-width: 640px)" srcset={asset('/img/limo/limo-square.webp')} type="image/webp" />
            <source media="(min-width: 640px)" srcset={asset('/img/limo/limo-square.jpg')} />
            <source srcset={asset('/img/limo/limo-story.webp')} type="image/webp" />
            <img src={asset('/img/limo/limo-story.jpg')} alt="Landschaftsgärtner-Limonade Gurke-Zitrone – von jedem Kasten gehen 5 Euro an die WM-Vorbereitung von Marc-Aurel und Lennard" loading="lazy" decoding="async" width="1200" height="1200" />
          </picture>
        </a>
        <div class="footer__limo-body">
          <h3 class="footer__h"><i class="fa-solid fa-bottle-droplet" aria-hidden="true"></i> Trinken. Unterstützen. Mitfiebern.</h3>
          <p class="footer__lead">
            Die neue <strong>Landschaftsgärtner-Limonade „Gurke-Zitrone"</strong> ist ab sofort erhältlich. Von jedem verkauften Kasten fließen <strong>5,00&nbsp;€</strong> direkt in die Trainings- und Wettkampfvorbereitung.
          </p>
          <ul class="footer__limo-facts">
            <li>1 Kasten = 20 Flaschen à 0,33&nbsp;l</li>
            <li><strong>20,00&nbsp;€</strong> <span>zzgl. 4,50&nbsp;€ Pfand + 19&nbsp;% MwSt.</span></li>
            <li>5,00&nbsp;€ pro Kasten für Marc-Aurel &amp; Lennard</li>
          </ul>
          <a class="footer__limo-btn" href={limoHref}>
            <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> Kasten bestellen
          </a>
          <p class="footer__limo-note">oder telefonisch: 0371&nbsp;77440-0</p>
        </div>
      </div>

      <!-- Spendenaufruf -->
      <div class="footer__donate">
      <div class="footer__donate-intro">
        <h3 class="footer__h"><i class="fa-solid fa-seedling" aria-hidden="true"></i> Unterstütze die Reise</h3>
        <p class="footer__lead">
          Trainingslager, Anreise, Coaching – die Vorbereitung auf Shanghai kostet. Jeder Beitrag hilft Marc-Aurel &amp; Lennard. Die Spenden sammelt der Verband Garten-, Landschafts- und Sportplatzbau Sachsen.
        </p>
      </div>
      <dl class="footer__bank">
        <dt>Kontoinhaber</dt>
        <dd>Verband Garten-, Landschafts- und Sportplatzbau Sachsen e.&nbsp;V.</dd>
        <dt>Bank</dt>
        <dd>BW Bank</dd>
        <dt>IBAN</dt>
        <dd class="footer__iban">
          <span data-iban>DE08 6005 0101 7472 5007 39</span>
          <button type="button" class="footer__iban-copy" data-iban-copy aria-label="IBAN kopieren">
            <i class="fa-solid fa-copy" aria-hidden="true"></i>
          </button>
        </dd>
        <dt>Verwendungszweck</dt>
        <dd>WorldSkills 2026</dd>
      </dl>
      </div>
    </div>

    <!-- Sponsoren -->
    <div class="footer__sponsors">
      <p class="footer__sponsors-label">Unterstützt von</p>
      <div class="footer__sponsors-grid">
        <a class="sponsor__link" href="https://wirth-wiener.de" target="_blank" rel="noopener" aria-label="Wirth & Wiener GmbH – zur Website">
          <img class="sponsor__logo" src={asset('/img/logo-ww.svg')} alt="Wirth & Wiener GmbH" width="200" height="32" />
        </a>
        <a class="sponsor__link" href="https://www.galabau-sachsen.de" target="_blank" rel="noopener" aria-label="Verband Garten-, Landschafts- und Sportplatzbau Sachsen – zur Website">
          <img class="sponsor__logo sponsor__logo--galabau" src={asset('/img/logo-galabau.png')} alt="Ihre Experten für Garten & Landschaft – Garten- und Landschaftsbau Sachsen" width="190" height="60" />
        </a>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__brand">Road to Shanghai · Wirth &amp; Wiener GmbH</p>
      <nav class="footer__legal" aria-label="Rechtliches">
        <a href="#impressum">Impressum</a>
        <a href="#datenschutz" id="datenschutz">Datenschutz</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  const root = document.querySelector('[data-share]');
  if (root) {
    const url = window.location.origin + '/';
    const title = 'Road to Shanghai – drück mit die Daumen!';
    const statusEl = document.querySelector('[data-share-status]');

    const wa = root.querySelector('[data-share-wa]');
    if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`;

    const fb = root.querySelector('[data-share-fb]');
    if (fb) fb.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;

    const x = root.querySelector('[data-share-x]');
    if (x) x.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;

    const copy = root.querySelector('[data-share-copy]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        if (statusEl) statusEl.textContent = 'Link kopiert! 🔗';
        setTimeout(() => { if (statusEl) statusEl.textContent = ''; }, 3000);
      } catch {
        if (statusEl) statusEl.textContent = url;
      }
    });
  }

  // IBAN kopieren
  const ibanBtn = document.querySelector('[data-iban-copy]');
  const ibanEl = document.querySelector('[data-iban]');
  ibanBtn?.addEventListener('click', async () => {
    const iban = (ibanEl?.textContent || '').replace(/\s+/g, '');
    try {
      await navigator.clipboard.writeText(iban);
      const orig = ibanBtn.innerHTML;
      ibanBtn.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i>';
      ibanBtn.classList.add('is-copied');
      setTimeout(() => { ibanBtn.innerHTML = orig; ibanBtn.classList.remove('is-copied'); }, 1600);
    } catch {}
  });
</script>

<style>
  .footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(3.5rem, 9vh, 6rem);
    border-top: 1px solid rgba(201, 162, 75, 0.18);
  }
  .footer__top {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 820px) {
    .footer__top { grid-template-columns: 1.2fr 1fr; align-items: start; }
  }
  .footer__h { font-size: 1.6rem; color: var(--gold); margin-bottom: 0.4rem; }
  .footer__lead { margin: 0 0 1.4rem; color: var(--ink-soft); font-size: 0.93rem; line-height: 1.55; }

  /* Spendenaufruf */
  .footer__donate {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid rgba(201, 162, 75, 0.28);
    border-radius: var(--radius);
    background: rgba(201, 162, 75, 0.05);
    display: grid;
    gap: 1.2rem 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .footer__donate { grid-template-columns: 1.1fr 1fr; align-items: center; }
  }
  .footer__donate .footer__h i { font-size: 1.1rem; margin-right: 0.3rem; }
  .footer__donate .footer__lead { margin: 0; }

  /* Unterstützen-Wrapper */
  .footer__support { margin-top: clamp(2.5rem, 6vh, 4rem); }
  .footer__support .footer__donate { margin-top: clamp(1.4rem, 3.5vh, 2.2rem); }

  /* Landschaftsgärtner-Limonade */
  .footer__limo {
    display: grid;
    gap: 1.4rem 2rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 720px) {
    .footer__limo { grid-template-columns: minmax(0, 300px) 1fr; }
  }
  .footer__limo-media {
    display: block;
    max-width: 340px;
    margin-inline: auto;
    border-radius: var(--radius);
    border: 1px solid rgba(201, 162, 75, 0.2);
    overflow: hidden;
    line-height: 0;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s var(--ease-out);
  }
  @media (min-width: 720px) { .footer__limo-media { max-width: none; } }
  .footer__limo-media:hover { transform: translateY(-3px); }
  .footer__limo-media img { width: 100%; height: auto; display: block; }
  .footer__limo .footer__h i { font-size: 1.1rem; margin-right: 0.3rem; }
  .footer__limo-facts {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--paper);
  }
  .footer__limo-facts li { position: relative; padding-left: 1.4rem; }
  .footer__limo-facts li::before { content: "🌿"; position: absolute; left: 0; font-size: 0.78rem; }
  .footer__limo-facts span { color: var(--ink-soft); }
  .footer__limo-facts strong { color: var(--gold); }
  .footer__limo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.72rem 1.4rem;
    border-radius: 999px;
    background: var(--china-red);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.18s var(--ease-out);
  }
  .footer__limo-btn:hover { background: var(--china-red-dk); transform: translateY(-2px); }
  .footer__limo-note { margin: 0.7rem 0 0; font-size: 0.82rem; color: var(--ink-soft); }
  .footer__bank {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    font-size: 0.9rem;
  }
  .footer__bank dt { color: var(--ink-soft); white-space: nowrap; }
  .footer__bank dd { margin: 0; color: var(--paper); }
  .footer__iban {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .footer__iban-copy {
    background: transparent;
    border: 1px solid rgba(201, 162, 75, 0.4);
    color: var(--gold);
    border-radius: 6px;
    width: 28px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .footer__iban-copy:hover { background: rgba(201, 162, 75, 0.14); }
  .footer__iban-copy.is-copied { color: var(--jade-lt, #7fd1b0); border-color: currentColor; }

  /* Social Icons */
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid rgba(201, 162, 75, 0.4);
    background: transparent;
    color: var(--gold);
    font-size: 1.05rem;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.22s ease, border-color 0.22s ease, transform 0.18s var(--ease-out);
  }
  .social-icon:hover {
    background: rgba(201, 162, 75, 0.16);
    border-color: var(--gold);
    transform: translateY(-3px);
    color: var(--gold);
  }
  .footer__share-status {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--jade-lt);
    min-height: 1.1em;
  }
  .footer__hashtags {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.01em;
  }

  .footer__sponsors {
    margin-top: clamp(3rem, 7vh, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid rgba(241, 232, 214, 0.1);
    text-align: center;
  }
  .footer__sponsors-label {
    font-size: var(--fs-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 1.25rem;
  }
  .footer__sponsors-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.25rem 2.75rem;
  }
  .sponsor__link { display: inline-flex; align-items: center; }
  /* Logos weiß auf dunklem Footer */
  .sponsor__logo {
    height: clamp(26px, 4vh, 34px);
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }
  .sponsor__logo:hover { opacity: 1; }
  /* GaLaBau-Logo (Text + Icon) etwas höher, damit die Zeilen lesbar bleiben */
  .sponsor__logo--galabau { height: clamp(36px, 5.5vh, 50px); }
  .sponsor {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.2;
    text-align: center;
    color: rgba(241, 232, 214, 0.7);
    padding: 0.5rem 1rem;
    border: 1px dashed rgba(201, 162, 75, 0.25);
    border-radius: var(--radius);
  }

  .footer__bottom {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-label);
    color: var(--ink-soft);
  }
  .footer__legal { display: flex; gap: 1.5rem; }
  .footer__legal a:hover { color: var(--gold); }
</style>
